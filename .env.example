# Copy to .env (never commit it) and fill in real values.
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me
SENDGRID_API_KEY=change-me
# Firebase Admin SDK key (Firebase console > Project settings > Service accounts
# > Generate new private key). Defaults to ./secrets/firebase-adminsdk.json.
# FIREBASE_CREDENTIALS_FILE=./secrets/firebase-adminsdk.json
